<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">
  <!-- @VERSION@ will be replaced by stage-msix.sh via msix-store.yml -->
  <Identity Name="nabbisen.pdf-tile-viewer"
            Publisher="CN=C4BA37E8-8670-4C82-8365-5ECB57373921"
            Version="@VERSION@" />
  <Properties>
    <DisplayName>pdf-tile-viewer</DisplayName>
    <PublisherDisplayName>nabbisen</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
  <Applications>
    <Application Id="App" Executable="pdf-tile-viewer.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="pdf-tile-viewer" Description="PDF viewer/reader displayed in tile layout."
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
